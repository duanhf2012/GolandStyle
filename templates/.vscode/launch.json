{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: Debug Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Go: Debug Current Test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "console": "integratedTerminal"
    },
    {
      "name": "Go: Attach to Local Process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": 0
    },
    {
      "name": "Go: Attach to Delve Server",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345
    }
  ]
}
