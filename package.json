{
  "name": "jetbrains-style-go-vscode",
  "displayName": "Goland Style",
  "description": "An unofficial GoLand-style Go development experience for Visual Studio Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/duanhf2012/GolandStyle.git"
  },
  "homepage": "https://github.com/duanhf2012/GolandStyle#readme",
  "bugs": {
    "url": "https://github.com/duanhf2012/GolandStyle/issues"
  },
  "version": "0.4.4",
  "publisher": "goland-style",
  "icon": "assets/icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:jetbrainsStyleGo.runConfigurations.open",
    "onCustomEditor:jetbrainsStyleGo.runConfigurationEditor",
    "onView:jetbrainsStyleGo.runConfigurationsView"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Extension Packs",
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "go",
    "golang",
    "goland",
    "jetbrains",
    "gopls",
    "darcula"
  ],
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "extensionPack": [
    "MS-CEINTL.vscode-language-pack-zh-hans",
    "fogio.jetbrains-file-icon-theme",
    "fogio.jetbrains-product-icon-theme",
    "golang.go"
  ],
  "golandStyle": {
    "runtimeSettings": {
      "go.useLanguageServer": true,
      "go.formatTool": "default",
      "go.lintOnSave": "off",
      "go.testExplorer.enable": true,
      "go.testExplorer.packageDisplayMode": "nested",
      "go.testExplorer.showDynamicSubtestsInEditor": true,
      "go.testTimeout": "30s",
      "go.coverageDecorator": {
        "type": "highlight",
        "coveredHighlightColor": "rgba(64,128,128,0.5)",
        "uncoveredHighlightColor": "rgba(128,64,64,0.25)",
        "coveredBorderColor": "rgba(64,128,128,0.5)",
        "uncoveredBorderColor": "rgba(128,64,64,0.25)",
        "coveredGutterStyle": "blockblue",
        "uncoveredGutterStyle": "slashyellow"
      },
      "go.toolsManagement.autoUpdate": false,
      "go.toolsManagement.checkForUpdates": "proxy",
      "go.editorContextMenuCommands": {
        "toggleTestFile": true,
        "addTags": true,
        "removeTags": false,
        "fillStruct": true,
        "implCursor": false,
        "testAtCursor": true,
        "testFile": false,
        "testPackage": false,
        "generateTestForFunction": false,
        "generateTestForFile": false,
        "generateTestForPackage": false,
        "addImport": true,
        "testCoverage": false,
        "playground": false,
        "debugTestAtCursor": true,
        "benchmarkAtCursor": false,
        "compilerDetails": false
      },
      "gopls": {
        "formatting.gofumpt": true,
        "ui.completion.usePlaceholders": true,
        "ui.semanticTokens": true,
        "ui.semanticTokenTypes": {
          "namespace": false
        },
        "ui.diagnostic.staticcheck": false,
        "ui.inlayhint.hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true
        }
      },
      "[go]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "editor.renderValidationDecorations": "off",
        "editor.semanticHighlighting.enabled": true,
        "editor.suggest.snippetsPreventQuickSuggestions": false
      },
      "[go.mod]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true
      },
      "[go.work]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true
      }
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "jetbrainsStyleGo.applySettings",
        "title": "应用 GoLand 风格设置",
        "category": "Goland Style"
      },
      {
        "command": "jetbrainsStyleGo.restoreSettings",
        "title": "恢复应用前的设置",
        "category": "Goland Style"
      },
      {
        "command": "jetbrainsStyleGo.installFont",
        "title": "安装 JetBrains Mono 字体",
        "category": "Goland Style"
      },
      {
        "command": "jetbrainsStyleGo.repairGoNavigation",
        "title": "修复 Go 跳转（gopls）",
        "category": "Goland Style"
      },
      {
        "command": "jetbrainsStyleGo.copyReference",
        "title": "复制引用",
        "category": "Goland Style"
      },
      {
        "command": "jetbrainsStyleGo.runConfigurations.open",
        "title": "编辑运行/调试配置",
        "category": "Goland Style",
        "icon": "$(settings-gear)"
      },
      {
        "command": "jetbrainsStyleGo.runConfigurations.refresh",
        "title": "刷新运行配置",
        "category": "Goland Style",
        "icon": "$(refresh)"
      },
      {
        "command": "jetbrainsStyleGo.runConfigurations.editItem",
        "title": "编辑运行配置",
        "category": "Goland Style",
        "icon": "$(edit)"
      },
      {
        "command": "jetbrainsStyleGo.runConfigurations.runItem",
        "title": "运行配置",
        "category": "Goland Style",
        "icon": "$(play)"
      },
      {
        "command": "jetbrainsStyleGo.runConfigurations.debugItem",
        "title": "调试配置",
        "category": "Goland Style",
        "icon": "$(debug-alt)"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle",
        "title": "切换匿名书签",
        "category": "Goland Style: Bookmarks",
        "icon": "$(bookmark)"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggleMnemonic",
        "title": "切换助记书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.show",
        "title": "显示行书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.next",
        "title": "下一个行书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.previous",
        "title": "上一个行书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.nextInEditor",
        "title": "当前编辑器中的下一个行书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.previousInEditor",
        "title": "当前编辑器中的上一个行书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.openView",
        "title": "打开 Bookmarks 工具窗口",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.addResource",
        "title": "添加或删除文件/目录书签",
        "category": "Goland Style: Bookmarks",
        "icon": "$(bookmark)"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.addResourceMnemonic",
        "title": "添加文件/目录助记书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.renameBookmark",
        "title": "重命名书签",
        "category": "Goland Style: Bookmarks",
        "icon": "$(edit)"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.removeMnemonic",
        "title": "移除书签助记符",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.deleteBookmark",
        "title": "删除书签",
        "category": "Goland Style: Bookmarks",
        "icon": "$(trash)"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.moveBookmark",
        "title": "移动书签到其他列表",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.moveBookmarkUp",
        "title": "向上移动书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.moveBookmarkDown",
        "title": "向下移动书签",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.createList",
        "title": "新建书签列表",
        "category": "Goland Style: Bookmarks",
        "icon": "$(add)"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.renameList",
        "title": "重命名书签列表",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.deleteList",
        "title": "删除书签列表",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.setDefaultList",
        "title": "设为默认书签列表",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.bookmarkOpenTabs",
        "title": "将所有打开的标签加入新书签列表",
        "category": "Goland Style: Bookmarks",
        "icon": "$(files)"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle0",
        "title": "切换数字书签 0",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle1",
        "title": "切换数字书签 1",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle2",
        "title": "切换数字书签 2",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle3",
        "title": "切换数字书签 3",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle4",
        "title": "切换数字书签 4",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle5",
        "title": "切换数字书签 5",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle6",
        "title": "切换数字书签 6",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle7",
        "title": "切换数字书签 7",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle8",
        "title": "切换数字书签 8",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.toggle9",
        "title": "切换数字书签 9",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo0",
        "title": "跳转到数字书签 0",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo1",
        "title": "跳转到数字书签 1",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo2",
        "title": "跳转到数字书签 2",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo3",
        "title": "跳转到数字书签 3",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo4",
        "title": "跳转到数字书签 4",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo5",
        "title": "跳转到数字书签 5",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo6",
        "title": "跳转到数字书签 6",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo7",
        "title": "跳转到数字书签 7",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo8",
        "title": "跳转到数字书签 8",
        "category": "Goland Style: Bookmarks"
      },
      {
        "command": "jetbrainsStyleGo.bookmarks.goTo9",
        "title": "跳转到数字书签 9",
        "category": "Goland Style: Bookmarks"
      }
    ],
    "customEditors": [
      {
        "viewType": "jetbrainsStyleGo.runConfigurationEditor",
        "displayName": "GoLand 风格运行/调试配置",
        "selector": [
          {
            "filenamePattern": "**/.vscode/launch.json"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Goland Style: Bookmarks",
      "properties": {
        "golandStyle.bookmarks.golandKeybindings": {
          "type": "boolean",
          "default": true,
          "description": "启用 GoLand 默认书签快捷键；安装扩展后默认开启，可关闭以恢复 VS Code 原生数字键位。"
        },
        "golandStyle.bookmarks.askBeforeReplacingMnemonic": {
          "type": "boolean",
          "default": true,
          "description": "覆盖已使用的数字或字母助记符前请求确认。"
        },
        "golandStyle.bookmarks.showOnlyLineBookmarksInPopup": {
          "type": "boolean",
          "default": true,
          "description": "Shift+F11 弹窗默认只显示代码行书签。"
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "command": "jetbrainsStyleGo.copyReference",
        "when": "editorTextFocus"
      },
      {
        "key": "f11",
        "mac": "f3",
        "command": "jetbrainsStyleGo.bookmarks.toggle",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+f11",
        "mac": "alt+f3",
        "command": "jetbrainsStyleGo.bookmarks.toggleMnemonic",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "shift+f11",
        "mac": "cmd+f3",
        "command": "jetbrainsStyleGo.bookmarks.show",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "alt+2",
        "mac": "cmd+2",
        "command": "jetbrainsStyleGo.bookmarks.openView",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "command": "jetbrainsStyleGo.bookmarks.next",
        "when": "config.golandStyle.bookmarks.golandKeybindings && focusedView == jetbrainsStyleGo.bookmarksView"
      },
      {
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "command": "jetbrainsStyleGo.bookmarks.previous",
        "when": "config.golandStyle.bookmarks.golandKeybindings && focusedView == jetbrainsStyleGo.bookmarksView"
      },
      {
        "key": "ctrl+shift+[Digit0]",
        "command": "jetbrainsStyleGo.bookmarks.toggle0",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit1]",
        "command": "jetbrainsStyleGo.bookmarks.toggle1",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit2]",
        "command": "jetbrainsStyleGo.bookmarks.toggle2",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit3]",
        "command": "jetbrainsStyleGo.bookmarks.toggle3",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit4]",
        "command": "jetbrainsStyleGo.bookmarks.toggle4",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit5]",
        "command": "jetbrainsStyleGo.bookmarks.toggle5",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit6]",
        "command": "jetbrainsStyleGo.bookmarks.toggle6",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit7]",
        "command": "jetbrainsStyleGo.bookmarks.toggle7",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit8]",
        "command": "jetbrainsStyleGo.bookmarks.toggle8",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+shift+[Digit9]",
        "command": "jetbrainsStyleGo.bookmarks.toggle9",
        "when": "config.golandStyle.bookmarks.golandKeybindings && editorTextFocus"
      },
      {
        "key": "ctrl+[Digit0]",
        "command": "jetbrainsStyleGo.bookmarks.goTo0",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit1]",
        "command": "jetbrainsStyleGo.bookmarks.goTo1",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit2]",
        "command": "jetbrainsStyleGo.bookmarks.goTo2",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit3]",
        "command": "jetbrainsStyleGo.bookmarks.goTo3",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit4]",
        "command": "jetbrainsStyleGo.bookmarks.goTo4",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit5]",
        "command": "jetbrainsStyleGo.bookmarks.goTo5",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit6]",
        "command": "jetbrainsStyleGo.bookmarks.goTo6",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit7]",
        "command": "jetbrainsStyleGo.bookmarks.goTo7",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit8]",
        "command": "jetbrainsStyleGo.bookmarks.goTo8",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      },
      {
        "key": "ctrl+[Digit9]",
        "command": "jetbrainsStyleGo.bookmarks.goTo9",
        "when": "config.golandStyle.bookmarks.golandKeybindings"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jetbrainsStyleGo-bookmarks",
          "title": "Bookmarks",
          "icon": "assets/bookmark.svg"
        }
      ]
    },
    "views": {
      "debug": [
        {
          "id": "jetbrainsStyleGo.runConfigurationsView",
          "name": "运行配置",
          "icon": "$(debug-alt)",
          "contextualTitle": "运行配置",
          "visibility": "visible"
        }
      ],
      "jetbrainsStyleGo-bookmarks": [
        {
          "id": "jetbrainsStyleGo.bookmarksView",
          "name": "Bookmarks"
        }
      ]
    },
    "submenus": [
      {
        "id": "jetbrainsStyleGo.copyPasteSpecial",
        "label": "复制/粘贴特殊"
      },
      {
        "id": "jetbrainsStyleGo.bookmarksMenu",
        "label": "书签"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jetbrainsStyleGo.runConfigurations.open",
          "when": "resourceFilename == launch.json",
          "group": "navigation@10"
        }
      ],
      "editor/title/run": [
        {
          "command": "jetbrainsStyleGo.runConfigurations.open",
          "when": "editorLangId == go",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "jetbrainsStyleGo.runConfigurations.open",
          "when": "view == jetbrainsStyleGo.runConfigurationsView",
          "group": "navigation@1"
        },
        {
          "command": "jetbrainsStyleGo.runConfigurations.refresh",
          "when": "view == jetbrainsStyleGo.runConfigurationsView",
          "group": "navigation@2"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.createList",
          "when": "view == jetbrainsStyleGo.bookmarksView",
          "group": "navigation@1"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.bookmarkOpenTabs",
          "when": "view == jetbrainsStyleGo.bookmarksView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jetbrainsStyleGo.runConfigurations.runItem",
          "when": "view == jetbrainsStyleGo.runConfigurationsView && viewItem == runConfiguration",
          "group": "inline@1"
        },
        {
          "command": "jetbrainsStyleGo.runConfigurations.debugItem",
          "when": "view == jetbrainsStyleGo.runConfigurationsView && viewItem == runConfiguration",
          "group": "inline@2"
        },
        {
          "command": "jetbrainsStyleGo.runConfigurations.editItem",
          "when": "view == jetbrainsStyleGo.runConfigurationsView && viewItem == runConfiguration",
          "group": "navigation@1"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.renameBookmark",
          "when": "view == jetbrainsStyleGo.bookmarksView && (viewItem == bookmark || viewItem == mnemonicBookmark)",
          "group": "inline@1"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.deleteBookmark",
          "when": "view == jetbrainsStyleGo.bookmarksView && (viewItem == bookmark || viewItem == mnemonicBookmark)",
          "group": "inline@2"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.removeMnemonic",
          "when": "view == jetbrainsStyleGo.bookmarksView && viewItem == mnemonicBookmark",
          "group": "bookmarks@1"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.moveBookmark",
          "when": "view == jetbrainsStyleGo.bookmarksView && (viewItem == bookmark || viewItem == mnemonicBookmark)",
          "group": "bookmarks@2"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.moveBookmarkUp",
          "when": "view == jetbrainsStyleGo.bookmarksView && (viewItem == bookmark || viewItem == mnemonicBookmark)",
          "group": "bookmarks@3"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.moveBookmarkDown",
          "when": "view == jetbrainsStyleGo.bookmarksView && (viewItem == bookmark || viewItem == mnemonicBookmark)",
          "group": "bookmarks@4"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.setDefaultList",
          "when": "view == jetbrainsStyleGo.bookmarksView && viewItem == bookmarkList",
          "group": "lists@1"
