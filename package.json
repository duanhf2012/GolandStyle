          "when": "view == jetbrainsStyleGo.bookmarksView && viewItem == bookmarkList",
          "group": "lists@2"
        },
        {
          "command": "jetbrainsStyleGo.bookmarks.deleteList",
          "when": "view == jetbrainsStyleGo.bookmarksView && viewItem == bookmarkList",
          "group": "lists@3"
        }
      ],
