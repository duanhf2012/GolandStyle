{
  "name": "Goland Style Full",
  "shortName": "Go Full",
  "settings": "{\"settings\":\"{\\n    \\\"chat.disableAIFeatures\\\": true,\\n    \\\"workbench.colorTheme\\\": \\\"JetBrains New UI Dark (Unofficial)\\\",\\n    \\\"workbench.iconTheme\\\": \\\"jetbrains-file-icon-theme-dark\\\",\\n    \\\"workbench.productIconTheme\\\": \\\"jetbrains-product-icon-theme\\\",\\n    \\\"workbench.activityBar.location\\\": \\\"default\\\",\\n    \\\"workbench.sideBar.location\\\": \\\"left\\\",\\n    \\\"workbench.panel.defaultLocation\\\": \\\"bottom\\\",\\n    \\\"workbench.tree.indent\\\": 16,\\n    \\\"workbench.tree.renderIndentGuides\\\": \\\"none\\\",\\n    \\\"workbench.tree.enableStickyScroll\\\": false,\\n    \\\"workbench.list.smoothScrolling\\\": true,\\n    \\\"workbench.list.horizontalScrolling\\\": true,\\n    \\\"workbench.editor.enablePreview\\\": false,\\n    \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n    \\\"workbench.editor.showTabs\\\": \\\"multiple\\\",\\n    \\\"workbench.editor.tabSizing\\\": \\\"fit\\\",\\n    \\\"workbench.editor.wrapTabs\\\": false,\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\n    \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\",\\n    \\\"workbench.layoutControl.enabled\\\": false,\\n    \\\"workbench.navigationControl.enabled\\\": false,\\n    \\\"window.zoomLevel\\\": 0,\\n    \\\"window.commandCenter\\\": true,\\n    \\\"breadcrumbs.enabled\\\": false,\\n    \\\"explorer.compactFolders\\\": false,\\n    \\\"files.autoSave\\\": \\\"off\\\",\\n    \\\"files.trimTrailingWhitespace\\\": true,\\n    \\\"files.insertFinalNewline\\\": true,\\n    \\\"search.smartCase\\\": true,\\n    \\\"search.useIgnoreFiles\\\": false,\\n    \\\"search.useParentIgnoreFiles\\\": false,\\n    \\\"search.useGlobalIgnoreFiles\\\": false,\\n    \\\"editor.fontFamily\\\": \\\"'JetBrains Mono', JetBrainsMono, Consolas, 'Courier New', monospace\\\",\\n    \\\"editor.fontSize\\\": 13.5,\\n    \\\"editor.lineHeight\\\": 21,\\n    \\\"editor.fontWeight\\\": \\\"400\\\",\\n    \\\"editor.letterSpacing\\\": 0,\\n    \\\"editor.fontLigatures\\\": true,\\n    \\\"editor.minimap.enabled\\\": false,\\n    \\\"editor.scrollBeyondLastLine\\\": false,\\n    \\\"editor.stickyScroll.enabled\\\": true,\\n    \\\"editor.renderWhitespace\\\": \\\"selection\\\",\\n    \\\"editor.renderControlCharacters\\\": true,\\n    \\\"editor.unicodeHighlight.nonBasicASCII\\\": false,\\n    \\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n    \\\"editor.guides.indentation\\\": true,\\n    \\\"editor.guides.highlightActiveIndentation\\\": true,\\n    \\\"editor.guides.bracketPairs\\\": false,\\n    \\\"editor.bracketPairColorization.enabled\\\": false,\\n    \\\"editor.glyphMargin\\\": true,\\n    \\\"editor.padding.top\\\": 6,\\n    \\\"editor.padding.bottom\\\": 4,\\n    \\\"editor.folding\\\": true,\\n    \\\"editor.showFoldingControls\\\": \\\"mouseover\\\",\\n    \\\"editor.matchBrackets\\\": \\\"always\\\",\\n    \\\"editor.parameterHints.enabled\\\": true,\\n    \\\"editor.inlayHints.enabled\\\": \\\"on\\\",\\n    \\\"editor.codeLens\\\": true,\\n    \\\"editor.linkedEditing\\\": true,\\n    \\\"editor.hover.delay\\\": 300,\\n    \\\"editor.cursorBlinking\\\": \\\"smooth\\\",\\n    \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n    \\\"editor.smoothScrolling\\\": true,\\n    \\\"editor.wordWrap\\\": \\\"off\\\",\\n    \\\"editor.multiCursorModifier\\\": \\\"alt\\\",\\n    \\\"editor.rulers\\\": [\\n        120\\n    ],\\n    \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n    \\\"debug.toolBarLocation\\\": \\\"commandCenter\\\",\\n    \\\"problems.decorations.enabled\\\": false,\\n    \\\"problems.defaultViewMode\\\": \\\"tree\\\",\\n    \\\"terminal.integrated.tabs.enabled\\\": true,\\n    \\\"terminal.integrated.defaultLocation\\\": \\\"view\\\",\\n    \\\"terminal.integrated.fontFamily\\\": \\\"'JetBrains Mono', JetBrainsMono, Consolas, 'Courier New', monospace\\\",\\n    \\\"terminal.integrated.fontSize\\\": 12,\\n    \\\"terminal.integrated.lineHeight\\\": 1.15,\\n    \\\"go.useLanguageServer\\\": true,\\n    \\\"go.formatTool\\\": \\\"default\\\",\\n    \\\"go.lintOnSave\\\": \\\"off\\\",\\n    \\\"go.testExplorer.enable\\\": true,\\n    \\\"go.testExplorer.packageDisplayMode\\\": \\\"nested\\\",\\n    \\\"go.testExplorer.showDynamicSubtestsInEditor\\\": true,\\n    \\\"go.testTimeout\\\": \\\"30s\\\",\\n    \\\"go.coverageDecorator\\\": {\\n        \\\"type\\\": \\\"highlight\\\",\\n        \\\"coveredHighlightColor\\\": \\\"rgba(64,128,128,0.5)\\\",\\n        \\\"uncoveredHighlightColor\\\": \\\"rgba(128,64,64,0.25)\\\",\\n        \\\"coveredBorderColor\\\": \\\"rgba(64,128,128,0.5)\\\",\\n        \\\"uncoveredBorderColor\\\": \\\"rgba(128,64,64,0.25)\\\",\\n        \\\"coveredGutterStyle\\\": \\\"blockblue\\\",\\n        \\\"uncoveredGutterStyle\\\": \\\"slashyellow\\\"\\n    },\\n    \\\"go.toolsManagement.autoUpdate\\\": false,\\n    \\\"go.toolsManagement.checkForUpdates\\\": \\\"proxy\\\",\\n    \\\"go.editorContextMenuCommands\\\": {\\n        \\\"toggleTestFile\\\": false,\\n        \\\"addTags\\\": false,\\n        \\\"removeTags\\\": false,\\n        \\\"fillStruct\\\": false,\\n        \\\"implCursor\\\": false,\\n        \\\"testAtCursor\\\": false,\\n        \\\"testFile\\\": false,\\n        \\\"testPackage\\\": false,\\n        \\\"generateTestForFunction\\\": false,\\n        \\\"generateTestForFile\\\": false,\\n        \\\"generateTestForPackage\\\": false,\\n        \\\"addImport\\\": false,\\n        \\\"testCoverage\\\": false,\\n        \\\"playground\\\": false,\\n        \\\"debugTestAtCursor\\\": false,\\n        \\\"benchmarkAtCursor\\\": false,\\n        \\\"compilerDetails\\\": false\\n    },\\n    \\\"gopls\\\": {\\n        \\\"formatting.gofumpt\\\": true,\\n        \\\"ui.completion.usePlaceholders\\\": true,\\n        \\\"ui.semanticTokens\\\": true,\\n        \\\"ui.semanticTokenTypes\\\": {\\n            \\\"namespace\\\": false\\n        },\\n        \\\"ui.diagnostic.staticcheck\\\": false,\\n        \\\"ui.inlayhint.hints\\\": {\\n            \\\"assignVariableTypes\\\": true,\\n            \\\"compositeLiteralFields\\\": true,\\n            \\\"compositeLiteralTypes\\\": true,\\n            \\\"constantValues\\\": true,\\n            \\\"functionTypeParameters\\\": true,\\n            \\\"parameterNames\\\": true,\\n            \\\"rangeVariableTypes\\\": true\\n        }\\n    },\\n    \\\"[go]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.codeActionsOnSave\\\": {\\n            \\\"source.organizeImports\\\": \\\"explicit\\\"\\n        },\\n        \\\"editor.renderValidationDecorations\\\": \\\"off\\\",\\n        \\\"editor.semanticHighlighting.enabled\\\": true,\\n        \\\"editor.suggest.snippetsPreventQuickSuggestions\\\": false\\n    },\\n    \\\"[go.mod]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[go.work]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    }\\n}\"}",
