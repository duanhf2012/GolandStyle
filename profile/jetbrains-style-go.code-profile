{
  "name": "Goland Style",
  "shortName": "Go",
  "settings": "{\"settings\":\"{\\n    \\\"workbench.colorTheme\\\": \\\"JetBrains New UI Dark (Unofficial)\\\",\\n    \\\"workbench.iconTheme\\\": \\\"jetbrains-file-icon-theme-dark\\\",\\n    \\\"workbench.productIconTheme\\\": \\\"jetbrains-product-icon-theme\\\",\\n    \\\"workbench.activityBar.location\\\": \\\"default\\\",\\n    \\\"workbench.sideBar.location\\\": \\\"left\\\",\\n    \\\"workbench.panel.defaultLocation\\\": \\\"bottom\\\",\\n    \\\"workbench.tree.indent\\\": 16,\\n    \\\"workbench.tree.renderIndentGuides\\\": \\\"none\\\",\\n    \\\"workbench.tree.enableStickyScroll\\\": false,\\n    \\\"workbench.list.smoothScrolling\\\": true,\\n    \\\"workbench.list.horizontalScrolling\\\": true,\\n    \\\"workbench.editor.enablePreview\\\": false,\\n    \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n    \\\"workbench.editor.showTabs\\\": \\\"multiple\\\",\\n    \\\"workbench.editor.tabSizing\\\": \\\"fit\\\",\\n    \\\"workbench.editor.wrapTabs\\\": false,\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\n    \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\",\\n    \\\"workbench.layoutControl.enabled\\\": false,\\n    \\\"workbench.navigationControl.enabled\\\": false,\\n    \\\"window.zoomLevel\\\": 0,\\n    \\\"window.commandCenter\\\": false,\\n    \\\"window.menuBarVisibility\\\": \\\"compact\\\",\\n    \\\"window.titleBarStyle\\\": \\\"custom\\\",\\n    \\\"breadcrumbs.enabled\\\": false,\\n    \\\"explorer.compactFolders\\\": false,\\n    \\\"jetbrains-file-icon-theme.enableGoTestIcons\\\": true,\\n    \\\"files.autoSave\\\": \\\"off\\\",\\n    \\\"files.trimTrailingWhitespace\\\": true,\\n    \\\"files.insertFinalNewline\\\": true,\\n    \\\"search.smartCase\\\": true,\\n    \\\"editor.fontFamily\\\": \\\"'JetBrains Mono', JetBrainsMono, Consolas, 'Courier New', monospace\\\",\\n    \\\"editor.fontSize\\\": 13.5,\\n    \\\"editor.lineHeight\\\": 21,\\n    \\\"editor.fontWeight\\\": \\\"400\\\",\\n    \\\"editor.letterSpacing\\\": 0,\\n    \\\"editor.fontLigatures\\\": true,\\n    \\\"editor.minimap.enabled\\\": false,\\n    \\\"editor.scrollBeyondLastLine\\\": false,\\n    \\\"editor.stickyScroll.enabled\\\": true,\\n    \\\"editor.renderWhitespace\\\": \\\"selection\\\",\\n    \\\"editor.renderControlCharacters\\\": true,\\n    \\\"editor.unicodeHighlight.nonBasicASCII\\\": false,\\n    \\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n    \\\"editor.guides.indentation\\\": true,\\n    \\\"editor.guides.highlightActiveIndentation\\\": true,\\n    \\\"editor.guides.bracketPairs\\\": false,\\n    \\\"editor.bracketPairColorization.enabled\\\": false,\\n    \\\"editor.glyphMargin\\\": true,\\n    \\\"editor.lineNumbersMinChars\\\": 3,\\n    \\\"editor.padding.top\\\": 6,\\n    \\\"editor.padding.bottom\\\": 4,\\n    \\\"editor.folding\\\": true,\\n    \\\"editor.showFoldingControls\\\": \\\"mouseover\\\",\\n    \\\"editor.matchBrackets\\\": \\\"always\\\",\\n    \\\"editor.parameterHints.enabled\\\": true,\\n    \\\"editor.inlayHints.enabled\\\": \\\"on\\\",\\n    \\\"editor.codeLens\\\": true,\\n    \\\"editor.linkedEditing\\\": true,\\n    \\\"editor.hover.delay\\\": 300,\\n    \\\"editor.cursorBlinking\\\": \\\"smooth\\\",\\n    \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n    \\\"editor.smoothScrolling\\\": true,\\n    \\\"editor.wordWrap\\\": \\\"off\\\",\\n    \\\"editor.multiCursorModifier\\\": \\\"alt\\\",\\n    \\\"editor.rulers\\\": [\\n        120\\n    ],\\n    \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n    \\\"problems.defaultViewMode\\\": \\\"tree\\\",\\n    \\\"terminal.integrated.tabs.enabled\\\": true,\\n    \\\"terminal.integrated.defaultLocation\\\": \\\"view\\\",\\n    \\\"terminal.integrated.fontFamily\\\": \\\"'JetBrains Mono', JetBrainsMono, Consolas, 'Courier New', monospace\\\",\\n    \\\"terminal.integrated.fontSize\\\": 12,\\n    \\\"terminal.integrated.lineHeight\\\": 1.15,\\n    \\\"errorLens.messageBackgroundMode\\\": \\\"message\\\",\\n    \\\"errorLens.problemRangeDecorationEnabled\\\": true,\\n    \\\"errorLens.gutterIconsEnabled\\\": true,\\n    \\\"errorLens.fontFamily\\\": \\\"'JetBrains Mono', JetBrainsMono, Consolas, 'Courier New', monospace\\\",\\n    \\\"errorLens.fontSize\\\": \\\"-1px\\\",\\n    \\\"errorLens.margin\\\": \\\"2ch\\\",\\n    \\\"todo-tree.general.tags\\\": [\\n        \\\"TODO\\\",\\n        \\\"FIXME\\\",\\n        \\\"BUG\\\",\\n        \\\"HACK\\\",\\n        \\\"XXX\\\"\\n    ],\\n    \\\"todo-tree.filtering.useBuiltInExcludes\\\": \\\"file and search excludes\\\",\\n    \\\"go.useLanguageServer\\\": true,\\n    \\\"go.formatTool\\\": \\\"default\\\",\\n    \\\"go.lintOnSave\\\": \\\"off\\\",\\n    \\\"go.testExplorer.enable\\\": true,\\n    \\\"go.testExplorer.packageDisplayMode\\\": \\\"nested\\\",\\n    \\\"go.testExplorer.showDynamicSubtestsInEditor\\\": true,\\n    \\\"go.testTimeout\\\": \\\"30s\\\",\\n    \\\"go.toolsManagement.autoUpdate\\\": false,\\n    \\\"go.toolsManagement.checkForUpdates\\\": \\\"proxy\\\",\\n    \\\"gopls\\\": {\\n        \\\"formatting.gofumpt\\\": true,\\n        \\\"ui.completion.usePlaceholders\\\": true,\\n        \\\"ui.semanticTokens\\\": true,\\n        \\\"ui.diagnostic.staticcheck\\\": true,\\n        \\\"ui.inlayhint.hints\\\": {\\n            \\\"assignVariableTypes\\\": true,\\n            \\\"compositeLiteralFields\\\": true,\\n            \\\"compositeLiteralTypes\\\": true,\\n            \\\"constantValues\\\": true,\\n            \\\"functionTypeParameters\\\": true,\\n            \\\"parameterNames\\\": true,\\n            \\\"rangeVariableTypes\\\": true\\n        }\\n    },\\n    \\\"[go]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.codeActionsOnSave\\\": {\\n            \\\"source.organizeImports\\\": \\\"explicit\\\"\\n        },\\n        \\\"editor.semanticHighlighting.enabled\\\": true,\\n        \\\"editor.suggest.snippetsPreventQuickSuggestions\\\": false\\n    },\\n    \\\"[go.mod]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[go.work]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[yaml]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\",\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.insertSpaces\\\": true,\\n        \\\"editor.tabSize\\\": 2\\n    },\\n    \\\"[toml]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"tamasfe.even-better-toml\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[proto]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"bufbuild.vscode-buf\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    }\\n}\"}",
  "extensions": "[{\"identifier\":{\"id\":\"jetbrains-style-go.jetbrains-style-go-vscode\"},\"displayName\":\"Goland Style\"},{\"identifier\":{\"id\":\"MS-CEINTL.vscode-language-pack-zh-hans\"},\"displayName\":\"Chinese (Simplified) Language Pack\"},{\"identifier\":{\"id\":\"EditorConfig.EditorConfig\"},\"displayName\":\"EditorConfig\"},{\"identifier\":{\"id\":\"bufbuild.vscode-buf\"},\"displayName\":\"Buf\"},{\"identifier\":{\"id\":\"golang.go\"},\"displayName\":\"Go\"},{\"identifier\":{\"id\":\"usernamehw.errorlens\"},\"displayName\":\"Error Lens\"},{\"identifier\":{\"id\":\"gruntfuggly.todo-tree\"},\"displayName\":\"Todo Tree\"},{\"identifier\":{\"id\":\"humao.rest-client\"},\"displayName\":\"REST Client\"},{\"identifier\":{\"id\":\"ms-vscode.makefile-tools\"},\"displayName\":\"Makefile Tools\"},{\"identifier\":{\"id\":\"redhat.vscode-yaml\"},\"displayName\":\"YAML\"},{\"identifier\":{\"id\":\"tamasfe.even-better-toml\"},\"displayName\":\"Even Better TOML\"},{\"identifier\":{\"id\":\"fogio.jetbrains-file-icon-theme\"},\"displayName\":\"JetBrains New UI File Icon Theme Extended\"},{\"identifier\":{\"id\":\"fogio.jetbrains-product-icon-theme\"},\"displayName\":\"JetBrains New UI Product Icon Theme\"}]"
