{
  "name": "Goland Style + GoLand Keymap",
  "shortName": "Go Keymap",
  "settings": "{\"settings\":\"{\\n    \\\"workbench.colorTheme\\\": \\\"JetBrains New UI Dark (Unofficial)\\\",\\n    \\\"workbench.iconTheme\\\": \\\"jetbrains-file-icon-theme-dark\\\",\\n    \\\"workbench.productIconTheme\\\": \\\"jetbrains-product-icon-theme\\\",\\n    \\\"workbench.activityBar.location\\\": \\\"default\\\",\\n    \\\"workbench.sideBar.location\\\": \\\"left\\\",\\n    \\\"workbench.panel.defaultLocation\\\": \\\"bottom\\\",\\n    \\\"workbench.tree.indent\\\": 16,\\n    \\\"workbench.tree.renderIndentGuides\\\": \\\"none\\\",\\n    \\\"workbench.tree.enableStickyScroll\\\": false,\\n    \\\"workbench.list.smoothScrolling\\\": true,\\n    \\\"workbench.list.horizontalScrolling\\\": true,\\n    \\\"workbench.editor.enablePreview\\\": false,\\n    \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n    \\\"workbench.editor.showTabs\\\": \\\"multiple\\\",\\n    \\\"workbench.editor.tabSizing\\\": \\\"fit\\\",\\n    \\\"workbench.editor.wrapTabs\\\": false,\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\n    \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\",\\n    \\\"workbench.layoutControl.enabled\\\": false,\\n    \\\"workbench.navigationControl.enabled\\\": false,\\n    \\\"window.zoomLevel\\\": 0,\\n    \\\"window.commandCenter\\\": false,\\n    \\\"breadcrumbs.enabled\\\": false,\\n    \\\"explorer.compactFolders\\\": false,\\n    \\\"files.autoSave\\\": \\\"off\\\",\\n    \\\"files.trimTrailingWhitespace\\\": true,\\n    \\\"files.insertFinalNewline\\\": true,\\n    \\\"search.smartCase\\\": true,\\n    \\\"editor.fontFamily\\\": \\\"'JetBrains Mono', JetBrainsMono, Consolas, 'Courier New', monospace\\\",\\n    \\\"editor.fontSize\\\": 13.5,\\n    \\\"editor.lineHeight\\\": 21,\\n    \\\"editor.fontWeight\\\": \\\"400\\\",\\n    \\\"editor.letterSpacing\\\": 0,\\n    \\\"editor.fontLigatures\\\": true,\\n    \\\"editor.minimap.enabled\\\": false,\\n    \\\"editor.scrollBeyondLastLine\\\": false,\\n    \\\"editor.stickyScroll.enabled\\\": true,\\n    \\\"editor.renderWhitespace\\\": \\\"selection\\\",\\n    \\\"editor.renderControlCharacters\\\": true,\\n    \\\"editor.unicodeHighlight.nonBasicASCII\\\": false,\\n    \\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n    \\\"editor.guides.indentation\\\": true,\\n    \\\"editor.guides.highlightActiveIndentation\\\": true,\\n    \\\"editor.guides.bracketPairs\\\": false,\\n    \\\"editor.bracketPairColorization.enabled\\\": false,\\n    \\\"editor.glyphMargin\\\": true,\\n    \\\"editor.padding.top\\\": 6,\\n    \\\"editor.padding.bottom\\\": 4,\\n    \\\"editor.folding\\\": true,\\n    \\\"editor.showFoldingControls\\\": \\\"mouseover\\\",\\n    \\\"editor.matchBrackets\\\": \\\"always\\\",\\n    \\\"editor.parameterHints.enabled\\\": true,\\n    \\\"editor.inlayHints.enabled\\\": \\\"on\\\",\\n    \\\"editor.codeLens\\\": true,\\n    \\\"editor.linkedEditing\\\": true,\\n    \\\"editor.hover.delay\\\": 300,\\n    \\\"editor.cursorBlinking\\\": \\\"smooth\\\",\\n    \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n    \\\"editor.smoothScrolling\\\": true,\\n    \\\"editor.wordWrap\\\": \\\"off\\\",\\n    \\\"editor.multiCursorModifier\\\": \\\"alt\\\",\\n    \\\"editor.rulers\\\": [\\n        120\\n    ],\\n    \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n    \\\"problems.defaultViewMode\\\": \\\"tree\\\",\\n    \\\"terminal.integrated.tabs.enabled\\\": true,\\n    \\\"terminal.integrated.defaultLocation\\\": \\\"view\\\",\\n    \\\"terminal.integrated.fontFamily\\\": \\\"'JetBrains Mono', JetBrainsMono, Consolas, 'Courier New', monospace\\\",\\n    \\\"terminal.integrated.fontSize\\\": 12,\\n    \\\"terminal.integrated.lineHeight\\\": 1.15,\\n    \\\"go.useLanguageServer\\\": true,\\n    \\\"go.formatTool\\\": \\\"default\\\",\\n    \\\"go.lintOnSave\\\": \\\"off\\\",\\n    \\\"go.testExplorer.enable\\\": true,\\n    \\\"go.testExplorer.packageDisplayMode\\\": \\\"nested\\\",\\n    \\\"go.testExplorer.showDynamicSubtestsInEditor\\\": true,\\n    \\\"go.testTimeout\\\": \\\"30s\\\",\\n    \\\"go.coverageDecorator\\\": {\\n        \\\"type\\\": \\\"highlight\\\",\\n        \\\"coveredHighlightColor\\\": \\\"rgba(64,128,128,0.5)\\\",\\n        \\\"uncoveredHighlightColor\\\": \\\"rgba(128,64,64,0.25)\\\",\\n        \\\"coveredBorderColor\\\": \\\"rgba(64,128,128,0.5)\\\",\\n        \\\"uncoveredBorderColor\\\": \\\"rgba(128,64,64,0.25)\\\",\\n        \\\"coveredGutterStyle\\\": \\\"blockblue\\\",\\n        \\\"uncoveredGutterStyle\\\": \\\"slashyellow\\\"\\n    },\\n    \\\"go.toolsManagement.autoUpdate\\\": false,\\n    \\\"go.toolsManagement.checkForUpdates\\\": \\\"proxy\\\",\\n    \\\"gopls\\\": {\\n        \\\"formatting.gofumpt\\\": true,\\n        \\\"ui.completion.usePlaceholders\\\": true,\\n        \\\"ui.semanticTokens\\\": true,\\n        \\\"ui.diagnostic.staticcheck\\\": true,\\n        \\\"ui.inlayhint.hints\\\": {\\n            \\\"assignVariableTypes\\\": true,\\n            \\\"compositeLiteralFields\\\": true,\\n            \\\"compositeLiteralTypes\\\": true,\\n            \\\"constantValues\\\": true,\\n            \\\"functionTypeParameters\\\": true,\\n            \\\"parameterNames\\\": true,\\n            \\\"rangeVariableTypes\\\": true\\n        }\\n    },\\n    \\\"[go]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.codeActionsOnSave\\\": {\\n            \\\"source.organizeImports\\\": \\\"explicit\\\"\\n        },\\n        \\\"editor.semanticHighlighting.enabled\\\": true,\\n        \\\"editor.suggest.snippetsPreventQuickSuggestions\\\": false\\n    },\\n    \\\"[go.mod]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[go.work]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"golang.go\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"golandStyle.bookmarks.golandKeybindings\\\": true\\n}\"}",
  "extensions": "[{\"identifier\":{\"id\":\"goland-style.jetbrains-style-go-vscode\"},\"displayName\":\"Goland Style\"},{\"identifier\":{\"id\":\"MS-CEINTL.vscode-language-pack-zh-hans\"},\"displayName\":\"Chinese (Simplified) Language Pack\"},{\"identifier\":{\"id\":\"golang.go\"},\"displayName\":\"Go\"},{\"identifier\":{\"id\":\"k--kato.intellij-idea-keybindings\"},\"displayName\":\"IntelliJ IDEA Keybindings\"},{\"identifier\":{\"id\":\"fogio.jetbrains-file-icon-theme\"},\"displayName\":\"JetBrains New UI File Icon Theme Extended\"},{\"identifier\":{\"id\":\"fogio.jetbrains-product-icon-theme\"},\"displayName\":\"JetBrains New UI Product Icon Theme\"}]",
  "keybindings": "{\"platform\":3,\"keybindings\":\"[\\n    {\\n        \\\"key\\\": \\\"alt+left\\\",\\n        \\\"command\\\": \\\"-workbench.action.previousEditor\\\",\\n        \\\"when\\\": \\\"!terminalFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+right\\\",\\n        \\\"command\\\": \\\"-workbench.action.nextEditor\\\",\\n        \\\"when\\\": \\\"!terminalFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+left\\\",\\n        \\\"command\\\": \\\"workbench.action.navigateBack\\\",\\n        \\\"when\\\": \\\"canNavigateBack\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+right\\\",\\n        \\\"command\\\": \\\"workbench.action.navigateForward\\\",\\n        \\\"when\\\": \\\"canNavigateForward\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+left\\\",\\n        \\\"command\\\": \\\"-workbench.action.navigateBack\\\",\\n        \\\"when\\\": \\\"canNavigateBack\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+right\\\",\\n        \\\"command\\\": \\\"-workbench.action.navigateForward\\\",\\n        \\\"when\\\": \\\"canNavigateForward\\\"\\n    }\\n]\"}"
}
